    "# Copy the code here and write a comment after EVERY line.\n",
    "\n",
    "loans = pd.read_csv(\"loans.csv\")# read the table from the file\n",
    "X = loans[[\"monthly_income\", \"loan_amount\"]].values # select the columns for features and convert to numpy array\n",
    "y = loans[[\"approved\"]].values # select the column for target variable and convert to numpy array\n",
    "\n",
    "X = StandardScaler().fit_transform(X) # standardize the features to have mean 0 and variance 1\n",
    "X = torch.tensor(X, dtype=torch.float32)# convert the features to a PyTorch tensor of type float32\n",
    "y = torch.tensor(y, dtype=torch.float32)# convert the target variable to a PyTorch tensor of type float32\n",
    "\n",
    "torch.manual_seed(42)# set the random seed for reproducibility\n",
    "model = nn.Sequential(nn.Linear(2, 8), nn.ReLU(), nn.Linear(8, 1), nn.Sigmoid())# define a neural network model with 2 input features, one hidden layer with 8 neurons and ReLU activation, and an output layer with 1 neuron and Sigmoid activation\n",
    "loss_fn = nn.BCELoss()# define the loss function as binary cross-entropy loss for binary classification\n",
    "optimizer = torch.optim.Adam(model.parameters(), lr=0.01)# define the optimizer as Adam with a learning rate of 0.01 to update the model parameters\n",
    "\n",
    "for epoch in range(100):# loop over 100 epochs for training the model\n",
    "    guess = model(X)# make predictions using the model on the input features\n",
    "    loss = loss_fn(guess, y)# calculate the loss by comparing the predictions with the true target values\n",
    "    optimizer.zero_grad()# reset the gradients of the model parameters to zero before backpropagation\n",
    "    loss.backward()# compute the gradients of the loss with respect to the model parameters using backpropagation\n",
    "    optimizer.step()# update the model parameters using the computed gradients and the optimizer\n",
    "\n",
    "print(\"final loss:\", round(loss.item(), 3))# print the final loss value after training, rounded to 3 decimal places"
   ]
  },
